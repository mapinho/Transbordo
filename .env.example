# Stack Django — DJANGO_DB_* foi deliberadamente mantido distinto de DB_*
# (do antigo stack Streamlit/SQLAlchemy, removido no Cutover/Fase 11) para os
# dois nunca apontarem pro mesmo banco por acidente enquanto conviviam no mesmo
# .env. O stack legado saiu; a separação de nomes fica como histórico (ver
# docs/decisions/0002).
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_NAME=transbordo
DJANGO_DB_USER=transbordo
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
# em container (Fase 10): DJANGO_DB_HOST=host.docker.internal — ver docs/DEPLOY.md
DJANGO_DB_PORT=5432

# Fase 7 — Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# E-mail transacional (opcional; sem isto o link "definir senha" fica desligado)
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=nao-responda@transbordo.local
# só para `manage.py criar_admin_vector --password-from-env`
ADMIN_VECTOR_PASSWORD=

# Fase 9 — mcp_server.py como cliente HTTP de /api/v1/
TRANSBORDO_API_URL=http://localhost:8000/api/v1
TRANSBORDO_API_KEY=
GEMINI_API_KEY=
